{
  "name": "env-gone",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Share environment variables with teammates through browser-encrypted, one-time links.",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "vite build",
    "predev": "vite build",
    "dev": "wrangler dev",
    "dev:api": "wrangler dev",
    "dev:ui": "vite",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "node tests/browser/smoke.mjs",
    "db:migrate:local": "wrangler d1 migrations apply env-gone --local",
    "db:migrate:remote": "wrangler d1 migrations apply env-gone --remote",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.2",
    "@cloudflare/workers-types": "^5.20261015.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "~5.9.3",
    "vite": "^8.3.4",
    "vitest": "^4.1.11",
    "wrangler": "^4.151.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261012.1": true
  }
}
